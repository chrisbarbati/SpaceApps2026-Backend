{
  "sources": {
    "requirements": {
      "name": "FAO ECOCROP",
      "url": "https://gaez.fao.org/pages/ecocrop",
      "note": "Crop environmental requirements. pH, temperature and rainfall are given as an optimal range and an absolute (tolerated) range; cycle is days from planting to harvest. Life span, soil texture (heavy, medium, light, organic) and drainage (poorly, well, excessive) are given as the optimal classes and every tolerated class. Extracted 2026-11-14 and 2026-11-15 from the public EcoCrop_DB.csv copy at github.com/OpenCLIM/ecocrop. Corn's life span, texture and drainage are blank under Zea mays and are taken from the Zea mays ssp. mays entry."
    },
    "estimates": {
      "name": "Illustrative estimates",
      "url": null,
      "note": "Nitrogen fixed and demanded, residue score, months of cover, net margin and disease susceptibility are placeholders chosen to be plausible for southern Ontario. They are not sourced and need agronomist review."
    },
    "notYetSourced": {
      "name": "Not yet sourced",
      "url": null,
      "note": "seasonWaterNeedMm (water a crop needs over its season) and heatUnitsRequired (crop heat units to mature) are empty for every crop. The planner has terms for them that stay out of the score until these values are sourced, for example from FAO-56 crop coefficients and provincial crop-heat-unit ratings."
    }
  },
